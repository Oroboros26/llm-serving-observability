{
  "title": "LLM serving",
  "uid": "llm-serving",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requests / s by status", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (status) (rate(llm_requests_total[1m]))", "legendFormat": "{{status}}"}]},
    {"id": 2, "type": "timeseries", "title": "Latency p50 / p95 / p99 (s)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(llm_request_seconds_bucket[5m])))", "legendFormat": "p50"},
       {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_request_seconds_bucket[5m])))", "legendFormat": "p95"},
       {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(llm_request_seconds_bucket[5m])))", "legendFormat": "p99"}]},
    {"id": 3, "type": "stat", "title": "Cache hit rate (5m)", "gridPos": {"x": 0, "y": 8, "w": 6, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "percentunit"}},
     "targets": [{"refId": "A", "expr": "sum(rate(llm_requests_total{cache=~\"hit.*\"}[5m])) / sum(rate(llm_requests_total[5m]))"}]},
    {"id": 4, "type": "stat", "title": "Error rate (5m)", "gridPos": {"x": 6, "y": 8, "w": 6, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "fieldConfig": {"defaults": {"unit": "percentunit"}},
     "targets": [{"refId": "A", "expr": "sum(rate(llm_requests_total{status=~\"5..\"}[5m])) / sum(rate(llm_requests_total[5m]))"}]},
    {"id": 5, "type": "timeseries", "title": "Upstream tokens / s", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (kind) (rate(llm_tokens_total[1m]))", "legendFormat": "{{kind}}"}]},
    {"id": 6, "type": "timeseries", "title": "Estimated spend (USD, last hour) by consumer", "gridPos": {"x": 0, "y": 14, "w": 24, "h": 7},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (consumer) (increase(llm_cost_usd_total[1h]))", "legendFormat": "{{consumer}}"}]}
  ]
}
